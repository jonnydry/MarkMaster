{
  "name": "markmaster",
  "version": "0.1.0",
  "description": "Search, tag, annotate, and curate your X bookmarks with collections, analytics, and local sync.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/check-db-migrations.mjs",
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev --webpack",
    "dev:turbo": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "dev:unchecked": "NODE_OPTIONS=--dns-result-order=ipv4first next dev --webpack",
    "dev:migrate": "npm run db:migrate && npm run dev:unchecked",
    "build": "next build",
    "analyze": "next experimental-analyze --output",
    "analyze:ui": "next experimental-analyze",
    "analyze:webpack": "ANALYZE=true next build --webpack",
    "deploy:build": "npm run db:migrate && npm run build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:status": "prisma migrate status",
    "db:check": "node scripts/check-db-migrations.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.14.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "nanoid": "^5.1.7",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pixi.js": "~8.18.1",
    "prisma": "^6.19.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "postcss": {
      ".": "8.5.18",
      "nanoid": "3.3.18"
    },
    "sharp": "0.35.0",
    "undici": "7.29.0"
  }
}
