# MarkMaster environment template
# Copy to .env and fill in values, then validate with: npm run env:check
# (chmod 600 .env is recommended locally)

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (pooled on Neon).
DATABASE_URL="postgresql://user:password@host:5432/markmaster"

# Direct (non-pooled) Postgres URL used by Prisma migrations.
# On Neon this is the non-pooler host — see docs/DATABASE.md.
DIRECT_URL="postgresql://user:password@host:5432/markmaster"

# Prod guard for db:migrate, embeddings:backfill, embeddings:backfill-images,
# and other write scripts
# (scripts/db-target-guard.mjs, docs/SMART_SEARCH.md "Two databases").
# A Neon host is written to only when the prod endpoint id is set and the
# host's endpoint id is in the dev list. Local hosts are always allowed.
# Endpoint ids are the ep-... part of the Neon hostname, not credentials.
# Unset prod id = every Neon host is refused unless you pass --prod or
# MARKMASTER_ALLOW_PROD=1. The guard is only as accurate as these two ids.
# Never put MARKMASTER_ALLOW_PROD in an env file: it only counts when set in
# the shell that launches the command, and a value here is ignored.
MARKMASTER_PROD_ENDPOINT_ID=""
MARKMASTER_DEV_ENDPOINT_IDS=""

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# X (Twitter) OAuth 2.0 credentials from https://developer.x.com
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# Public URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# 64-char hex key for encrypting X tokens at rest. Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# ── Required in production ──────────────────────────────────────────────────

# Distributed rate limiting. The proxy returns 503 in production without these.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Authorizes sync-worker dispatch and /api/internal/sync/worker.
# Generate: openssl rand -hex 32
SYNC_WORKER_SECRET=""

# Authorizes Vercel Cron queue draining (also accepted by the worker route).
CRON_SECRET=""

# Prisma User.id allowed to access debug endpoints; they fail closed in
# production when unset.
OWNER_USER_ID=""

# Self-hosted production only: set to "true" behind a trusted reverse proxy
# that replaces forwarded Host headers. Vercel is detected automatically.
# AUTH_TRUST_HOST="true"

# ── Optional ────────────────────────────────────────────────────────────────

# Override the public origin used when building share links (e.g. behind a
# vanity domain). Defaults to NEXTAUTH_URL.
# APP_URL=""
# NEXT_PUBLIC_APP_URL=""

# TypeSafe System One (Jev). Server-side only — never NEXT_PUBLIC_.
# Unlocks Sweep (72-bookmark) scans and one-shot library classify.
# TYPESAFE_API_KEY=""
# TYPESAFE_DEFAULT_MODEL="jev-latest"

# Enables Grok Orbit scans.
# XAI_API_KEY=""
# Override the xAI API base URL or Orbit model.
# XAI_API_BASE_URL="https://api.x.ai/v1"
# XAI_ORBIT_MODEL="grok-4.7"

# Content-Security-Policy mode. Production defaults to "enforce"; use
# "report-only" only for a temporary diagnostics/rollback window.
# CSP_MODE="enforce"

# Number of trusted reverse-proxy hops when resolving the client IP for rate
# limiting (see src/lib/client-ip.ts). Vercel needs no configuration.
# TRUSTED_PROXY_HOPS="1"

# Orbit scan enrichment phase toggle.
# ORBIT_SCAN_ENRICHMENT="on"

# Parallel Jev (TypeSafe) requests during a scan (1-32, default 12).
# Failed items abstain into leftovers, so higher values are safe.
# ORBIT_JEV_ASSIGN_CONCURRENCY="12"

# Packed Jev calls in flight while auto-tagging the whole queue (1-16, default 6).
# Rate-limited packs retry with backoff; lower this if TypeSafe keeps throttling.
# ORBIT_LIBRARY_PACK_CONCURRENCY="6"

# ORBIT_LIBRARY_GROWTH="false"

# ── Development conveniences ────────────────────────────────────────────────

# Skip the migration-status check that `npm run dev` performs.
# SKIP_DB_MIGRATION_CHECK="1"

# Run live xAI integration tests (costs tokens). File: src/lib/orbit-grok.live.test.ts
# RUN_LIVE_XAI_TESTS="1"

# Run live TypeSafe/Jev eval tests (costs tokens). File: src/lib/orbit-jev-eval.live.test.ts
# RUN_LIVE_TYPESAFE_TESTS="1"

# Local smart search (opt-in mode=smart). Ollama on this machine.
# See docs/SMART_SEARCH.md. The default bookmark search ignores these.
# Post-sync embedding runs only when OLLAMA_BASE_URL is set. Leave it unset
# on Vercel production so a sync does not call Ollama. Query embed and the
# manual backfill scripts still default to localhost while this stays commented.
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# EMBEDDING_MODEL="embeddinggemma-2:270m"
# EMBEDDING_IMAGE_MODEL="embeddinggemma-2:440m-q8_0-text-vision"
# Query-embed cap in milliseconds (default 4000). A finished embed returns immediately.
# embeddings:image-scores uses 30000 when this is unset.
# SMART_SEARCH_EMBED_TIMEOUT_MS="4000"
# Image cosine cutoff (default 0.68, must be in [0.3, 1)). Below 0.3 falls back.
# Dev calibration, 1317 image embeds, embeddinggemma-2:440m-q8_0-text-vision,
# text side embeddinggemma-2:270m, 16 real queries + 2 controls (aggregates only):
# Image controls max 0.647 / 0.630 (p99 0.61 / 0.58). Real-query top-1 0.659-0.804
# (median 0.744). >=0.70 nearly all correct, 0.65-0.68 mixed, <0.65 nearly all wrong.
# Text top-1 0.639-0.782, rank 10 0.590-0.718 (median ~0.64). Median bookmark 0.52-0.63,
# so text ~0.60 is near noise. Cutoff 0.65 with weight 0.5 put no image-only hit in the top 10.
# Image score = cosine - 0.03 (IMAGE_HIT_SCORE_OFFSET). Merged = max(text, image score)
# + 0.02 (DUAL_MATCH_SCORE_BONUS) when both match. Those two are code constants.
# IMAGE_HIT_SIMILARITY_CUTOFF="0.68"
# Ollama server, not this app: OLLAMA_MAX_LOADED_MODELS=2 keeps both models loaded.
# One loaded model spends 1.4-1.7s swapping.
# keep_alive on embed calls (default 30m). One unit from 1s to 24h. -1, 0, and 1h30m fall back to 30m.
# OLLAMA_EMBED_KEEP_ALIVE="30m"
# A text embed timeout skips text-vector search for 60s. An image timeout skips image search. No setting.
