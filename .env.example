# Copy to .env and fill in values. Validate with: npm run env:check
# Database ops (Neon DIRECT_URL, migrations): docs/DATABASE.md

# PostgreSQL (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://user:password@localhost:5432/markmaster"

# Direct connection for Prisma migrations (local: same as DATABASE_URL).
# Neon: use the non-pooler host for DIRECT_URL; keep the -pooler host on DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/markmaster"

# Neon: In console.neon.tech open your project → Connect. Use the pooled
# connection string (host ends in -pooler.<region>.aws.neon.tech) as DATABASE_URL,
# and the direct (non-pooler) string as DIRECT_URL. Database neondb (or your DB
# name), sslmode=require. Prisma uses IPv4-first DNS in src/lib/prisma.ts for Neon.

# Auth.js v5 — required for sessions/cookies (generate: openssl rand -base64 32)
AUTH_SECRET=

# App URL — must match how you open the app (used in OAuth redirects)
NEXTAUTH_URL=http://localhost:3000

# Required for self-hosted production behind a trusted reverse proxy. Vercel is
# detected automatically. Only enable this after configuring the proxy to
# replace, rather than append, forwarded Host headers.
# AUTH_TRUST_HOST=true

# X Developer Portal → your app → Keys → OAuth 2.0 Client ID and Client Secret
# User authentication settings: OAuth 2.0
# Callback URL (add exactly): http://localhost:3000/api/auth/callback/twitter
# Scopes: tweet.read, users.read, bookmark.read, offline.access
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Token encryption at rest (generate: openssl rand -hex 32)
# Existing deployments using older shorter keys must rotate to a 64-character
# hex value before starting this version.
ENCRYPTION_KEY=

# Optional: xAI Grok-powered Orbit scan
XAI_API_KEY=

# Optional: override the default Grok model or send requests to a regional xAI endpoint
XAI_ORBIT_MODEL=grok-4.6
XAI_API_BASE_URL=https://api.x.ai/v1

# --- Production hardening (required for deployed environments) ---

# Production rate limiting using Upstash Redis (works great on Vercel too).
# Get free credentials at https://upstash.com or use Vercel KV (compatible).
# REQUIRED in production: the proxy returns 503 if this is unset there.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Background sync worker — required in production. POST /api/bookmarks/sync enqueues
# a PENDING SyncRun and dispatches this route (separate serverless invocation).
# Vercel Cron also drains the queue every 5 minutes using CRON_SECRET if set.
# Generate: openssl rand -base64 32
# SYNC_WORKER_SECRET=
# CRON_SECRET=

# Restrict internal debug/admin tools to a single user (Prisma User.id).
# REQUIRED in production to access /api/debug/rate-limits and GET /api/csp-report:
# if unset in production, those endpoints fail closed (return 404) for everyone.
# In development, when set it limits access to that user; when unset, any
# authenticated user may access the debug tools.
# OWNER_USER_ID=

# Optional: Content-Security-Policy mode. Production defaults to "enforce";
# development defaults to "report-only". Use report-only temporarily to inspect
# violations during a production rollback window.
# CSP_MODE=enforce

# Optional: number of trusted reverse proxies / CDNs in front of the app, used to
# resolve the real client IP for the global rate limiter without trusting
# spoofable x-forwarded-for hops. Defaults to 1 (Vercel / Cloudflare / single
# proxy). Set to your actual proxy count, or 0 if the app is directly exposed.
# TRUSTED_PROXY_HOPS=1
